# Copy to .env and fill in. Never commit .env.
# Required: protects the web dashboard (HTTP Basic auth). Use a long random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_PASSWORD=

# Optional / not used by the paper bot. Prices come from public Binance streams.
# If you add a Binance key: enable "Reading" only, disable withdrawals, restrict to your VPS IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Not used in this build (paper trading only). Reserved for a future live mode.
POLYMARKET_PRIVATE_KEY=
